# Orbit API — Environment variables template.
#
# Copy this file to `.env` and fill in the real values.
# `.env` is gitignored. This file is committed.
#
# Real values live in /home/<user>/projects/CREDENTIALS-MAP.md
# (outside the repo, on the local machine only).

# -------------------------------------------------------------------
# Environment
# -------------------------------------------------------------------

# development or production
ENVIRONMENT=development

# DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# -------------------------------------------------------------------
# Database
# -------------------------------------------------------------------

# PostgreSQL connection string.
# Format: postgresql+asyncpg://USER:PASSWORD@HOST:PORT/DATABASE
#
# From Supabase: Project Settings → Database → Connection String
# Use the "Connection pooling" variant with the session pooler
# for production, and the direct connection for local development.
DATABASE_URL=postgresql+asyncpg://postgres:REPLACE_ME@db.REPLACE_ME.supabase.co:5432/postgres

# -------------------------------------------------------------------
# Supabase
# -------------------------------------------------------------------

# The project URL. Looks like https://xxxxxxxxxxxxx.supabase.co
SUPABASE_URL=https://REPLACE_ME.supabase.co

# The publishable (public) key. Safe to expose to the frontend.
# Format: sb_publishable_...
SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME

# The secret key. Backend-only. Never reaches the frontend.
# Format: sb_secret_...
SUPABASE_SECRET_KEY=sb_secret_REPLACE_ME

# -------------------------------------------------------------------
# CORS
# -------------------------------------------------------------------

# Comma-separated list of allowed origins.
# Development: http://localhost:5173
# Production: your deployed frontend URL
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
