# Orbit Web — Environment variables template.
#
# Copy this file to `.env` and fill in the real values.
# `.env` is gitignored. This file is committed.
#
# Real values live in CREDENTIALS-MAP.md outside the repo.

# Supabase project URL.
# Format: https://xxxxx.supabase.co
VITE_SUPABASE_URL=https://REPLACE_ME.supabase.co

# Supabase publishable key.
# Format: sb_publishable_...
# This key is public and ships to the browser.
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME

# The Orbit API base URL.
# Local development: http://localhost:8000
VITE_API_URL=http://localhost:8000
