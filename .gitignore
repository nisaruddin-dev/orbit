# Orbit root .gitignore

# Dependencies
node_modules/
.pnpm-store/
.venv/
__pycache__/
*.pyc
*.pyo

# Build outputs
dist/
build/
.next/
out/
*.egg-info/

# Environment and secrets
.env
.env.*
!.env.example
*.key
*.pem
credentials.json

# OS and editor junk
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*.swo
*~

# Logs
*.log
npm-debug.log*
pnpm-debug.log*

# Python / uv
.uv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Cache
.cache/
.parcel-cache/
.turbo/
.eslintcache

# Misc
*.local
.tmp/
tmp/
